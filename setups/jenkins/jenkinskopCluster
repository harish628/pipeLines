pipeline {
    agent any

    parameters {

        string(
            name: 'KOPS_STATE_BUCKET',
            defaultValue: 'shopflow-project-s3',
            description: 'S3 bucket used as the KOps state store'
        )

        string(
            name: 'CLUSTER_NAME',
            defaultValue: 'shopflow.k8s.local',
            description: 'Kubernetes cluster name (e.g. shopflow.k8s.local)'
        )

        choice(
            name: 'REGION',
            choices: [
                'ap-south-1',
                'us-east-1',
                'us-west-2',
                'eu-west-1'
            ],
            description: 'AWS Region'
        )

        string(
            name: 'ZONES',
            defaultValue: 'ap-south-1a',
            description: 'Availability Zones (comma separated if multiple)'
        )

        string(
            name: 'AMI_ID',
            defaultValue: 'ami-09d88f7c4c272b0c5',
            description: 'AWS AMI ID'
        )

        choice(
            name: 'MASTER_INSTANCE',
            choices: [
                'c7i-flex.large',
                 't3.micro',
                'm7i.large'
            ],
            description: 'Master instance type'
        )
        
        choice(
            name: 'WORKER_INSTANCE',
            choices: [
                'c7i-flex.large',
                't3.micro',
                'm7i.large'
            ],
            description: 'Master instance type'
        )

        string(
            name: 'MASTER_COUNT',
            defaultValue: '1',
            description: 'Number of master nodes'
        )

        string(
            name: 'WORKER_COUNT',
            defaultValue: '2',
            description: 'Number of worker nodes'
        )

        string(
            name: 'MASTER_VOLUME',
            defaultValue: '28',
            description: 'Master root volume size (GB)'
        )

        string(
            name: 'WORKER_VOLUME',
            defaultValue: '28',
            description: 'Worker root volume size (GB)'
        )

        choice(
            name: 'OPERATION',
            choices: [
                'Create',
                'Delete',
                'Status'
            ],
            description: 'Select the KOps operation'
        )
    }

    stages {

        stage('Display Inputs') {
            steps {
                script {
                    echo """
                            =====================================================
                                         KOps Cluster Configuration
                            =====================================================
                            
                            Cluster Name      : ${params.CLUSTER_NAME}
                            State Store       : ${params.KOPS_STATE_BUCKET}
                            AWS Region        : ${params.REGION}
                            Availability Zone : ${params.ZONES}
                            
                            AMI ID            : ${params.AMI_ID}
                            
                            Master Type       : ${params.MASTER_INSTANCE}
                            Worker Type       : ${params.WORKER_INSTANCE}
                            
                            Master Count      : ${params.MASTER_COUNT}
                            Worker Count      : ${params.WORKER_COUNT}
                            
                            Master Volume     : ${params.MASTER_VOLUME} GB
                            Worker Volume     : ${params.WORKER_VOLUME} GB
                            
                            Operation         : ${params.OPERATION}
                            
                            =====================================================
                            """
                }
            }
        }
        stage('CODE') {
            steps {
                git 'https://github.com/harish628/pipeLines.git'
            }
        }
        stage('Install KOps') {
            steps {
                sh '''
                    chmod +x setups/scripts/install/kops.sh
                    bash setups/scripts/install/kops.sh
                '''
            }
        }
        stage('Install kubectl') {
                steps {
                    sh '''
                        chmod +x setups/scripts/install/kubectl.sh
                        bash setups/scripts/install/kubectl.sh
                    '''
                }
        }
        stage('Install Helm') {

            steps {
                sh '''
                        chmod +x setups/scripts/install/helm.sh
                        bash setups/scripts/install/helm.sh
                    '''
            }
        }
        
        stage('AWS Authentication') {

            steps {

                withAWS(
                    credentials: 'aws-jenkins',
                    region: 'ap-south-1'
                ) {

                    sh '''
                    aws sts get-caller-identity
                    '''

                }

            }
        }
        stage('Create KOps State Store') {

            steps {
        
                withAWS(credentials: 'aws-jenkins',region: "${params.REGION}"
                ) {
        
                    sh """
                        chmod +x setups/scripts/install/createS3.sh
        
                        bash setups/scripts/install/createS3.sh \
                        ${params.KOPS_STATE_BUCKET} \
                        ${params.REGION}
                    """
        
                }
        
            }
        }
        stage('Create KOps Cluster') {
             when {
                    expression {
                        params.OPERATION == 'Create'
                    }
                }
            steps {
                withAWS(credentials: 'aws-jenkins',region: "${params.REGION}"
                ) {
                        sh """
                
                        chmod +x setups/scripts/install/createKopsCluster.sh
                
                        bash setups/scripts/install/createKopsCluster.sh \
                        ${params.CLUSTER_NAME} \
                        ${params.KOPS_STATE_BUCKET} \
                        ${params.REGION} \
                        ${params.ZONES} \
                        ${params.AMI_ID} \
                        ${params.MASTER_INSTANCE} \
                        ${params.WORKER_INSTANCE} \
                        ${params.MASTER_COUNT} \
                        ${params.WORKER_COUNT} \
                        ${params.MASTER_VOLUME} \
                        ${params.WORKER_VOLUME}
                
                        """
                }
            }
        }
        stage('Delete KOps Cluster') {
            
                when {
                    expression {
                        params.OPERATION == 'Delete'
                    }
                }
            
                steps {
            
                    withAWS(
                        credentials: 'aws-jenkins',
                        region: "${params.REGION}"
                    ) {
            
                        sh """
            
                        chmod +x setups/scripts/delete/deleteCluster.sh
            
                        bash setups/scripts/delete/deleteCluster.sh \
                        ${params.CLUSTER_NAME} \
                        ${params.KOPS_STATE_BUCKET} \
                        ${params.REGION}
            
                        """
            
                    }
                }
            }
        
        
    }
}